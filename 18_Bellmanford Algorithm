import java.util.*;

public class BellmanFord {
    
    // Sentinel value representing "infinity" (unreachable)
    private static final int INF = Integer.MAX_VALUE;
    
    /**
     * Bellman-Ford Single Source Shortest Path algorithm.
     * Handles negative edge weights and detects negative weight cycles.
     *
     * @param n      Number of vertices (1-indexed: 1, 2, ..., n)
     * @param src    Source vertex
     * @param edges  List of edges, each as int[]{u, v, weight}
     * @return       Array of distances from src to each vertex (1-indexed; index 0 unused)
     * @throws RuntimeException if negative weight cycle is detected
     */
    public static int[] bellmanFord(int n, int src, List<int[]> edges) {
        // Step 1: Initialize distances to infinity, except source = 0
        int[] dist = new int[n + 1];  // 1-indexed, index 0 unused
        Arrays.fill(dist, INF);
        dist[src] = 0;
        
        // Step 2: Relax all edges (V - 1) times
        for (int i = 0; i < n - 1; i++) {
            for (int[] edge : edges) {
                int u = edge[0];
                int v = edge[1];
                int wt = edge[2];
                
                // Relaxation: if path through u is shorter, update
                // The dist[u] != INF check prevents overflow
                if (dist[u] != INF && dist[u] + wt < dist[v]) {
                    dist[v] = dist[u] + wt;
                }
            }
        }
        
        // Step 3: Check for negative weight cycle
        // If we can still relax an edge after V-1 iterations, there's a negative cycle
        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];
            int wt = edge[2];
            
            if (dist[u] != INF && dist[u] + wt < dist[v]) {
                throw new RuntimeException("Negative weight cycle found");
            }
        }
        
        return dist;
    }
    
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();
        int m = scanner.nextInt();
        
        List<int[]> edges = new ArrayList<>();
        for (int i = 0; i < m; i++) {
            int u = scanner.nextInt();
            int v = scanner.nextInt();
            int wt = scanner.nextInt();
            edges.add(new int[]{u, v, wt});
        }
        
        try {
            int[] distance = bellmanFord(n, 1, edges);
            for (int i = 1; i <= n; i++) {
                if (distance[i] == INF) {
                    System.out.println("node " + i + " is at dist INF (unreachable)");
                } else {
                    System.out.println("node " + i + " is at dist " + distance[i]);
                }
            }
        } catch (RuntimeException e) {
            System.out.println(e.getMessage());
        }
        
        scanner.close();
    }
}




vector<int> bellmanford(int n, int src, vector<vector<int>> edges) {
    vector<int> dist(n + 1, INT_MAX);
    dist[src] = 0;

    //relax all edges (v-1) timeshttps://leetcode.com/problems/network-delay-time/discuss/
    for (int i = 0; i < n - 1; i++) {
        //goto every edge and relax it
        for (auto edge : edges) {
            int u = edge[0];
            int v = edge[1];
            int wt = edge[2];

            if (dist[u] != INT_MAX and dist[u] + wt < dist[v]) {
                dist[v] = dist[u] + wt;
            }
        }
    }
    //negative wt cycle
    for (auto edge : edges) {
        int u = edge[0];
        int v = edge[1];
        int wt = edge[2];
        if (dist[u] != INT_MAX and dist[u] + wt < dist[v]) {
            cout << "negative wt cycle found";
            exit(0);
        }
    }
    return dist;
}

int main()
{
    int n, m;
    cin >> n >> m;

    //edge list
    vector<vector<int>> edges;
    for (int i = 0; i < m; i++) {
        int u, v, wt;
        cin >> u >> v >> wt;
        edges.push_back({u, v, wt});
    }

    //bellmanford algo
    vector<int> distance = bellmanford(n, 1, edges);
    for (int i = 1; i <= n; i++) {
        cout << "node " << i << " is at dist " << distance[i] << endl;
    }
}
